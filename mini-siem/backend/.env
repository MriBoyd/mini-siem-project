# Database
DATABASE_URL=postgres://siemuser:siempassword@localhost/siemdb
REDIS_URL=redis://localhost:6379

API_BIND=127.0.0.1:9090


# Kafka
KAFKA_BROKERS=localhost:9092

# API Security
API_KEY=your-secure-api-key-here

# Slack (optional - get from https://api.slack.com/apps)
SLACK_WEBHOOK=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Rust logging
RUST_LOG=info

# Optional: seed a mock admin user after migrations. Set to "1" or "true" to enable.
# When enabled the app will create an admin user if it does not already exist.
# Defaults used when env vars are not provided:
#   MOCK_ADMIN_EMAIL=admin@example.com
#   MOCK_ADMIN_PASSWORD=password123
# Example:
#   SEED_MOCK_ADMIN=1
#   MOCK_ADMIN_EMAIL=admin@example.com
#   MOCK_ADMIN_PASSWORD=password123
SEED_MOCK_ADMIN=0
MOCK_ADMIN_EMAIL=admin@example.com
MOCK_ADMIN_PASSWORD=password123
