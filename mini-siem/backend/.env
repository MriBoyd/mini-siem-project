# Database
DATABASE_URL=postgres://siemuser:siempassword@localhost/siemdb
REDIS_URL=redis://localhost:6379

API_BIND=127.0.0.1:9090


# Kafka
KAFKA_BROKERS=localhost:9092

# API Security
