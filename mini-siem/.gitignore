# Root .gitignore for the mini-siem project

# macOS
.DS_Store

# Node.js / frontend build artifacts and deps
frontend/node_modules/
frontend/.next/
frontend/build/

# Ignore local env files but keep sample or committed env files
frontend/.env.local
frontend/.env.*.local

# Rust / backend
backend/target/

# IDEs and editors
.vscode/
.idea/
*.swp
*~

# Python
__pycache__/
*.py[cod]

# Docker
docker-compose.override.yml

# Local environment files (ignore local secrets)
.env.local
.env.*.local

# OS generated
Thumbs.db

# Go agent (if present)
agent/bin/
agent/vendor/

# Terraform / infrastructure
infrastructure/terraform/.terraform/

# Kubernetes local manifests
infrastructure/kubernetes/*.local

# Build artifact leftovers
**/dist/
**/build/

# Logs and temp files
logs/
*.log
*.tmp

# Misc
*.rs.bk
